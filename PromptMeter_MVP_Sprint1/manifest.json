{
  "manifest_version": 3,
  "name": "PromptMeter — Medidor de Custo",
  "default_locale": "pt_BR",
  "version": "0.4.0",
  "description": "Conte tokens e veja o custo de cada prompt (e da resposta) em tempo real. 100% local e determinístico — sem IA. Funciona em ChatGPT, Claude, Gemini e Perplexity.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PromptMeter — Opções",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "css": [
        "overlay.css"
      ],
      "js": [
        "tokenizer.js",
        "pricing.js",
        "models.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html"
}
